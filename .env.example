# Keep the API on loopback unless you also place it behind an authenticated reverse proxy.
STREAMSENSE_API_HOST=127.0.0.1
STREAMSENSE_API_PORT=8000
STREAMSENSE_BACKEND_CONFIG=configs/backends.json
STREAMSENSE_BACKEND_PROFILE=vllm-qwen25-vl-3b
STREAMSENSE_MODEL_MANIFEST=models/serve_manifest.json
STREAMSENSE_DATABASE=data/events_v2.db
STREAMSENSE_FEEDBACK_DATABASE=data/feedback_v2.db
STREAMSENSE_FEEDBACK_EXPORT_DIR=artifacts/training_candidates

# Generate independent random values; never commit real tokens.
STREAMSENSE_ADMIN_TOKEN=replace-with-a-long-random-value
STREAMSENSE_FEEDBACK_TOKEN=replace-with-a-different-long-random-value
STREAMSENSE_INFERENCE_TOKEN=replace-with-a-third-long-random-value

# smoke performs offline tests and a local API startup; full starts a GPU backend.
PORTFOLIO_V2_MODE=smoke
STREAMSENSE_BACKEND_RUNTIME=vllm
# benchmark runs measured API/backend load and exits; serve remains resident.
STREAMSENSE_V2_ACTION=benchmark
STREAMSENSE_BENCHMARK_REQUESTS=20
STREAMSENSE_BENCHMARK_CONCURRENCY=4
STREAMSENSE_BENCHMARK_MAX_TOKENS=64
STREAMSENSE_BENCHMARK_SAMPLE_GPU=1
